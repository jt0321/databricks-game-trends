# Copy to `.env` and adjust if needed. No real secrets belong in this repo.

# --- Local extractors (all optional) ---
GAME_TRENDS_UA=game-trend-lakehouse/0.1
GAME_TRENDS_SAMPLE_N=25
GAME_TRENDS_OUT_DIR=data/raw

# --- Twitch Helix (core engagement source) ---
# Register a free app at https://dev.twitch.tv/console/apps to obtain these.
# Needed by `game-trends-extract-engagement` for viewership snapshots; the
# Steam CCU half of that extractor works without them (--skip-twitch).
# The same credentials will later unlock IGDB metadata.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
