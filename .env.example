# Copy to `.env` and adjust if needed. No real secrets belong in this repo.

# --- Local extractor (all optional) ---
GAME_TRENDS_UA=game-trend-lakehouse/0.1
GAME_TRENDS_SAMPLE_N=25
GAME_TRENDS_OUT_DIR=data/raw

# --- Optional Twitch Helix extension ---
# Register an app at https://dev.twitch.tv/console/apps to obtain these.
# The default pipeline does NOT require Twitch — leave these unset to skip it.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
