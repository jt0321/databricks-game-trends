# Copy to `.env` and adjust if needed. No real secrets belong in this repo.

# --- Local extractors (all optional) ---
GAME_TRENDS_UA=game-trend-lakehouse/0.1
GAME_TRENDS_SAMPLE_N=25
GAME_TRENDS_OUT_DIR=data/raw

# --- Twitch Helix (core engagement source) ---
# Register a free app at https://dev.twitch.tv/console/apps to obtain these.
# Needed by `game-trends-extract-engagement` for viewership snapshots; the
# Steam CCU half of that extractor works without them (--skip-twitch).
# The same credentials will later unlock IGDB metadata.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Reddit (engagement extension) ---
# Register a free "script" app at https://www.reddit.com/prefs/apps.
# Needed by `game-trends-extract-engagement` for subreddit snapshots
# (--skip-reddit to run without them).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Gamalytic (Steam revenue/unit estimates) ---
# Free tier signup: https://gamalytic.com/pricing (~2500 requests/day).
# Needed by `game-trends-extract-estimates` (--skip-gamalytic to run without
# it — SteamSpy owner-tier estimates still work with no credentials).
GAMALYTIC_API_KEY=

# Steam reviews, Wikipedia pageviews, and SteamSpy owner-tier estimates need
# no credentials at all. Google Trends backfill (`game-trends-backfill
# --sources trends`) needs the optional `pytrends` dependency
# (`uv sync --extra trends`) but no API key — Google Trends has no official
# API or auth.
